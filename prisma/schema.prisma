// Схема базы Filmhub.
// Движок один и тот же локально и на сервере (PostgreSQL), поэтому переезд
// сводится к применению миграций: prisma migrate deploy.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String          @id @default(cuid())
  name       String?
  email      String?         @unique
  image      String?
  createdAt  DateTime        @default(now())
  telegramId String?         @unique
  accounts   Account[]
  positions  WatchPosition[]
  saved      SavedItem[]
}

/// Способы входа: google, позже telegram. Один пользователь — несколько входов.
model Account {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  email             String?
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// Позиция просмотра. season/episode = 0 для фильмов: в Postgres NULL-значения
/// в уникальном индексе считаются разными, и одна пара «фильм + серия» могла бы
/// создать две строки.
model WatchPosition {
  id        String  @id @default(cuid())
  userId    String
  filmId    Int
  season    Int     @default(0)
  episode   Int     @default(0)
  seconds   Int     @default(0)
  duration  Int?
  completed Boolean @default(false)

  /// Оценка времени у плеера (fallback, когда позиция недоступна).
  /// Ограничиваем двумя минутами сверху: точнее всё равно не узнать.
  watchedSeconds Int       @default(0)
  /// Сколько раз пользователь запускал просмотр
  opens          Int       @default(0)
  /// 'player' — настоящая позиция из нашего плеера, 'fallback' — только факт просмотра
  source         String    @default("fallback")
  startedAt      DateTime?
  lastOpenedAt   DateTime?

  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, filmId, season, episode])
  @@index([userId, updatedAt])
}

/// Сохранённое на потом. Привязано к профилю, а не только к аккаунту:
/// сохранять можно без входа (как историю просмотра), а после входа через
/// Telegram записи автоматически оказываются в аккаунте.
model SavedItem {
  id        String   @id @default(cuid())
  userId    String
  filmId    Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// один фильм — одна запись у профиля
  @@unique([userId, filmId])
  /// выборка «моё сохранённое» идёт по профилю с сортировкой по дате
  @@index([userId, createdAt])
}

/// Найденный трейлер. Храним отдельно от данных TMDB: так мы не зависим от того,
/// что TMDB передумает отдавать видео, и можем хранить свои находки с YouTube.
model Trailer {
  id        String   @id @default(cuid())
  filmId    Int
  /// movie или tv: у TMDB разные нумерации, без типа возможны коллизии
  media     String?
  youtubeId String
  title     String?
  lang      String?
  /// tmdb или youtube — откуда взят трейлер
  source    String   @default("tmdb")
  createdAt DateTime @default(now())

  @@unique([filmId, media, youtubeId])
  @@index([filmId])
}

/// Очередь заполнения трейлеров. Это тот самый «единый список»: по нему идём
/// от популярных к редким, а статус не даёт проверять одно и то же повторно.
model TrailerTask {
  id         String   @id @default(cuid())
  filmId     Int
  tmdbId     Int?
  /// movie или tv
  media      String?
  title      String?
  year       Int?
  /// популярность из TMDB: по ней сортируем очередь
  popularity Float    @default(0)
  /// pending | done | skipped | failed
  status     String   @default("pending")
  attempts   Int      @default(0)
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([filmId, media])
  @@index([status, popularity])
}

/// Соответствие TMDB ↔ Кинопоиск, найденное через платную API Кинопоиска.
/// Нужно потому, что от кинопоискового id зависит, попадёт ли фильм в каталог:
/// без него карточку некуда вести.
model KpMap {
  id        String   @id @default(cuid())
  tmdbId    Int
  /// movie или tv — у TMDB разные нумерации
  media     String
  kpId      Int
  title     String?
  year      Int?
  createdAt DateTime @default(now())

  @@unique([tmdbId, media])
  @@index([kpId])
}

/// Соответствие TMDB ↔ IMDb. Заполняется скриптом через TMDB external_ids.
/// Нужно, чтобы каталог мог показать фильм даже без кинопоискового id:
/// плеер принимает imdb (tt...), а он есть почти у всего.
model ImdbMap {
  id        String   @id @default(cuid())
  tmdbId    Int
  /// movie или tv
  media     String
  imdbId    String
  createdAt DateTime @default(now())

  @@unique([tmdbId, media])
  @@index([imdbId])
}
